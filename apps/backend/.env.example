PORT=4000
WEB_URL=http://localhost:3000

# Neon connection string. Prisma reads this directly from the environment,
# so it is not part of the zod schema in src/lib/env.ts.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Redis for the BullMQ snapshot/provisioning queue.
REDIS_URL=redis://localhost:6379

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback

# Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
CRYPTO_KEY=

# Workspace image. The default adds an SSH server on top of code-server so
# users can connect from VS Code / Cursor / Antigravity / JetBrains.
# Build it once:
#   docker build -f infra/docker/Dockerfile -t cloudide-workspace:latest .
#WORKSPACE_IMAGE=cloudide-workspace:latest
